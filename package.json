{
  "name": "poketrade",
  "version": "1.0.0",
  "private": true,
  "description": "PokéTrade — Pokémon GO rarity comparison (independent fan project)",
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:build && next build",
    "build:site": "next build",
    "start": "node scripts/serve-static.mjs out",
    "lint": "tsc --noEmit",
    "data:fetch": "tsx scripts/pipeline/fetch-sources.ts",
    "data:build": "tsx scripts/pipeline/build-catalog.ts",
    "data:update": "npm run data:fetch && npm run data:build",
    "data:rollback": "tsx scripts/pipeline/rollback.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
